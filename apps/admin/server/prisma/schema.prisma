generator client {
  provider = "prisma-client-js"
}

// The connection_limit and pool_timeout are appended to the URL at runtime
// by Prisma's connection pool. To fix P2024 timeout errors with Neon pooler,
// keep connection_limit low (since Neon pooler manages its own pool).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bio                String?
  isVerified         Boolean             @default(false)
  lastReadDate       DateTime?
  longestStreak      Int                 @default(0)
  name               String?
  profilePicture     String?
  readingStreak      Int                 @default(0)
  role               UserRole            @default(AUTHOR)
  writerLevel        Int                 @default(1)
  writerXP           Int                 @default(0)
  blogs              Blog[]
  bookmarks          Bookmark[]
  coAuthoredBlogs    CoAuthor[]
  comments           Comment[]
  conversations1     Conversation[]      @relation("Participant1")
  conversations2     Conversation[]      @relation("Participant2")
  following          Follow[]            @relation("Followers")
  followers          Follow[]            @relation("Following")
  followerSnapshots  FollowerSnapshot[]
  highlights         Highlight[]
  receivedMessages   Message[]           @relation("Receiver")
  sentMessages       Message[]           @relation("Sender")
  notifications      Notification[]
  personalizedScores PersonalizedScore[]
  subscribedTo       PremiumAccess[]
  readingHistory     ReadingHistory[]
  series             Series[]
  subscriptions      Subscription[]      @relation("Creator")
  tipsReceived       Tip[]               @relation("TipReceiver")
  tipsSent           Tip[]               @relation("Tipper")
  achievements       UserAchievement[]
  collabSessions     CollabSession[]
  collabInviteTokens CollabInviteToken[]
  blogLikes          BlogLike[]
}

model Blog {
  id                 String           @id @default(cuid())
  title              String
  content            String
  published          Boolean          @default(false)
  authorId           String
  likes              Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  coverImage         String?
  featured           Boolean          @default(false)
  isPremium          Boolean          @default(false)
  readabilityScore   Float?
  readingCompletions Int              @default(0)
  scheduledAt        DateTime?
  seriesId           String?
  seriesOrder        Int?
  summary            String?
  views              Int              @default(0)
  ydocState          Bytes?
  author             User             @relation(fields: [authorId], references: [id])
  series             Series?          @relation(fields: [seriesId], references: [id])
  versions           BlogVersion[]
  bookmarks          Bookmark[]
  coAuthors          CoAuthor[]
  comments           Comment[]
  highlights         Highlight[]
  readingHistory     ReadingHistory[]
  tags               Tag[]            @relation("BlogToTag")
  collabSessions     CollabSession[]
  collabInviteTokens CollabInviteToken[]
  blogLikes          BlogLike[]

  @@index([seriesId])
  @@index([authorId])
  @@index([scheduledAt])
  @@index([published, updatedAt])
  @@index([published, views])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  blogs Blog[] @relation("BlogToTag")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  blogId    String
  author    User     @relation(fields: [authorId], references: [id])
  blog      Blog     @relation(fields: [blogId], references: [id])

  @@index([authorId])
  @@index([blogId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  blogId    String
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, blogId])
  @@index([userId])
  @@index([blogId])
}

model Notification {
  id        String   @id @default(cuid())
  message   String
  read      Boolean  @default(false)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ReadingHistory {
  id     String   @id @default(cuid())
  userId String
  blogId String
  readAt DateTime @default(now())
  blog   Blog     @relation(fields: [blogId], references: [id])
  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, blogId])
  @@index([userId])
  @@index([blogId])
}

model Series {
  id          String   @id @default(cuid())
  name        String
  description String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  blogs       Blog[]
  author      User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model BlogVersion {
  id        String   @id @default(cuid())
  blogId    String
  title     String
  content   String
  version   Int
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([blogId, version])
  @@index([blogId])
}

model CoAuthor {
  id        String       @id @default(cuid())
  blogId    String
  userId    String
  role      CoAuthorRole @default(CONTRIBUTOR)
  status    InviteStatus @default(PENDING)
  createdAt DateTime     @default(now())
  blog      Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])

  @@unique([blogId, userId])
  @@index([userId])
}

model Conversation {
  id             String    @id @default(cuid())
  participant1Id String
  participant2Id String
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())
  participant1   User      @relation("Participant1", fields: [participant1Id], references: [id])
  participant2   User      @relation("Participant2", fields: [participant2Id], references: [id])
  messages       Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  senderId       String
  receiverId     String
  conversationId String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  receiver       User         @relation("Receiver", fields: [receiverId], references: [id])
  sender         User         @relation("Sender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
}

model Achievement {
  id          String            @id @default(cuid())
  name        String            @unique
  description String
  icon        String            @default("🏆")
  xpReward    Int               @default(0)
  criteria    String
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

model Highlight {
  id          String   @id @default(cuid())
  userId      String
  blogId      String
  text        String
  startOffset Int
  endOffset   Int
  note        String?
  createdAt   DateTime @default(now())
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([blogId])
}

model DailyViewStat {
  id     String   @id @default(cuid())
  blogId String
  date   DateTime @db.Date
  views  Int      @default(0)

  @@unique([blogId, date])
  @@index([blogId])
}

model FollowerSnapshot {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  count  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
}

model Subscription {
  id           String          @id @default(cuid())
  creatorId    String
  tierName     String
  description  String?
  priceInCents Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  access       PremiumAccess[]
  creator      User            @relation("Creator", fields: [creatorId], references: [id])

  @@index([creatorId])
}

model PremiumAccess {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String
  startsAt       DateTime     @default(now())
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, subscriptionId])
  @@index([userId])
}

model Tip {
  id            String   @id @default(cuid())
  tipperId      String
  receiverId    String
  amountInCents Int
  message       String?
  createdAt     DateTime @default(now())
  receiver      User     @relation("TipReceiver", fields: [receiverId], references: [id])
  tipper        User     @relation("Tipper", fields: [tipperId], references: [id])

  @@index([tipperId])
  @@index([receiverId])
}

model PersonalizedScore {
  id     String @id @default(cuid())
  userId String
  tagId  String
  score  Float  @default(0)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, tagId])
  @@index([userId])
}

enum UserRole {
  AUTHOR
  ADMIN
  CONTRIBUTOR
}

enum CoAuthorRole {
  CO_AUTHOR
  CONTRIBUTOR
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ── Collaboration Session Tracking ─────────────────────────────────────────────

model CollabSession {
  id        String    @id @default(cuid())
  blogId    String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  blog      Blog      @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([blogId])
  @@index([userId])
}

model CollabInviteToken {
  id        String             @id @default(cuid())
  token     String             @unique
  blogId    String
  creatorId String
  status    CollabTokenStatus  @default(ACTIVE)
  expiresAt DateTime
  maxUses   Int                @default(5)
  uses      Int                @default(0)
  createdAt DateTime           @default(now())
  blog      Blog               @relation(fields: [blogId], references: [id], onDelete: Cascade)
  creator   User               @relation(fields: [creatorId], references: [id])

  @@index([token])
  @@index([blogId])
}

enum CollabTokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model BlogLike {
  id        String   @id @default(cuid())
  blogId    String
  userId    String
  createdAt DateTime @default(now())
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([blogId, userId])
  @@index([blogId])
  @@index([userId])
}
